# ─────────────────────────────────────────────────────────────
# CAMPUS CART — Backend environment template
# Copy to backend/.env and fill in real values. Never commit .env
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Public origin of this API (used to build local upload URLs in dev only)
API_PUBLIC_URL=http://localhost:5000

# Frontend origin(s) allowed by CORS. Comma-separate for multiple.
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas ────────────────────────────────────────────
# Leave empty in development to run a disposable in-memory MongoDB.
# REQUIRED in production.
MONGO_URI=mongodb+srv://parsekarshravani_db_user:I1IhspOOoiF1PUD3@campuscart.glu0jpw.mongodb.net/campus_cart?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Cookie cross-site policy for production (Vercel/Render): none
# Same-origin deployments can keep lax.
COOKIE_SAMESITE=none

# Only allow college email domains. Empty = any email domain is accepted.
COLLEGE_EMAIL_DOMAINS=

# ── Cloudinary image storage ─────────────────────────────────
# If these are empty, uploads fall back to local disk storage
# (backend/uploads) which is for DEVELOPMENT ONLY.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campus-cart

# ── Email verification (optional) ────────────────────────────
# Configure all EMAIL_* values to enable verification emails and
# enforce verified accounts at login. Without them, accounts are
# created unverified but login is permitted and no email is sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CAMPUS CART <no-reply@campuscart.app>

# ── Admin seed account (used by `npm run seed`) ──────────────
ADMIN_NAME=CAMPUS CART Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@12345

# ── Demo data ────────────────────────────────────────────────
# Set to false to keep an empty database on startup.
SEED_DEMO_DATA=true
